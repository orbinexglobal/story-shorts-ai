# StoryShorts AI — copy this file to .env and fill in your keys.
# .env is gitignored — never commit real secrets.
# In GitHub Actions, set these as repository secrets instead (see
# .github/workflows/pipeline.yml).

# Text-AI provider (required — at least one; OpenRouter recommended)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional fallback providers
# GEMINI_API_KEY=
# GROQ_API_KEY=

# YouTube Data API (required for uploads; from Google Cloud console)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# Get the refresh token via: python scripts/get_youtube_refresh_token.py
