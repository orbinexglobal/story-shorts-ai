# Secrets — never commit these
.env
*.key
client_secret*.json
token.json
credentials.json

# Large analytics exports (keep the extracted CSVs in analytics/, not the zips)
Content *.zip

# Runtime artifacts
temp/*
!temp/.gitkeep
output/*
!output/.gitkeep
logs/*.jsonl
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/
